    "og": "tsx scripts/og-images.ts",
    "audit": "tsx scripts/audit-tracks.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^31.0.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
